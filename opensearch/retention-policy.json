{
  "policy": {
    "policy_id": "biomero-logs-retention",
    "description": "Age off container logs so the volume cannot fill. Applied by scripts/apply-opensearch-retention.sh; tune the ages here rather than in the script.",
    "default_state": "hot",
    "ism_template": [
      {
        "index_patterns": ["biomero-logs*"],
        "priority": 100
      }
    ],
    "states": [
      {
        "name": "hot",
        "actions": [
          {
            "rollover": {
              "min_primary_shard_size": "20gb",
              "min_index_age": "7d"
            }
          }
        ],
        "transitions": [
          {
            "state_name": "warm",
            "conditions": { "min_index_age": "7d" }
          }
        ]
      },
      {
        "name": "warm",
        "actions": [
          { "force_merge": { "max_num_segments": 1 } }
        ],
        "transitions": [
          {
            "state_name": "delete",
            "conditions": { "min_index_age": "90d" }
          }
        ]
      },
      {
        "name": "delete",
        "actions": [{ "delete": {} }],
        "transitions": []
      }
    ]
  }
}
