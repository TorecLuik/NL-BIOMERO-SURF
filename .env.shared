# Shared deployment settings.
#
# Keep internet-facing credentials out of this section in a gitignored .env when deploying.

NL_BIOMERO_VERSION=1.8.0
BIOMERO_IMPORTER_VERSION=1.4.2
BIOMERO_VERSION=2.8.2
OMERO_ZARR_PIXEL_BUFFER_VERSION=0.6.1
OMERO_FORMS_VERSION=2.3.1
OMERO_BIOMERO_VERSION=1.6.1

SPIDER_USER=biomero-sloev
SPIDER_PROJECT=biomero
OMERO_CSRF_TRUSTED_ORIGINS=["https://biomerodev.sda-development.src.surf-hosted.nl"]

# Public URLs and dashboard IDs.
METABASE_SITE_URL=https://biomerodev.sda-development.src.surf-hosted.nl/metabase
OBSERVABILITY_ROOT_URL=https://biomerodev.sda-development.src.surf-hosted.nl/logs/
METABASE_IMPORTS_DB_PAGE_DASHBOARD_ID=6
METABASE_WORKFLOWS_DB_PAGE_DASHBOARD_ID=2

# Enables the BIOMERO.importer frontend in OMERO.biomero.
IMPORTER_ENABLED=TRUE
COMPOSE_PROFILES=IMPORTER_ENABLED
# To disable the BIOMERO.importer service, comment the above line and uncomment:
# IMPORTER_ENABLED=FALSE
# COMPOSE_PROFILES=adi_disabled

# Enables the BIOMERO.analyzer frontend in OMERO.biomero.
ANALYZER_ENABLED=TRUE
# To disable the BIOMERO.analyzer service, comment the above line and uncomment:
# ANALYZER_ENABLED=FALSE
# COMPOSE_PROFILES=biomero_disabled

# Internal database settings. These are not directly exposed by the public
# nginx/OMERO/Metabase surfaces in this deployment.
POSTGRES_USER=omero
POSTGRES_PASSWORD=omero
POSTGRES_DB=omero

BIOMERO_POSTGRES_USER=biomero
BIOMERO_POSTGRES_PASSWORD=biomero
BIOMERO_POSTGRES_DB=biomero

# OMERO timeout and logging settings.
OMERO_SCRIPTS_TIMEOUT=604800000
OMERO_SESSIONS_TIMEOUT=604800000
OMERO_WEB_SESSION_EXPIRE_AT_BROWSER_CLOSE=false
OMERO_WEB_SESSION_COOKIE_AGE=604800
OMERO_LOGGING_LEVEL=10

# Keep BIOMERO's Slurm accounting query narrow enough for shared clusters.
BIOMERO_SACCT_START_TIME=today

# GPU policy. These are upstream BIOMERO settings as of 2.8.2; the old
# NL-BIOMERO runtime patch that hand-rolled this behavior has been retired.
#
# inject_gpu_flag makes BIOMERO emit --nv and GPU sbatch resources only for
# workflows whose effective use_gpu is true. Which workflows those are is set
# per workflow with <workflow>_job_use_gpu in slurm-config.ini, and a request
# can still override it at runtime.
#
# The partition/gres values below are only fallbacks: upstream appends them
# solely when the workflow's own job params do not already carry that flag.
# Per-workflow overrides therefore belong in slurm-config.ini, for example
# deconvolve_plate pinning itself to full A100 with
# deconvolve_plate_job_partition and deconvolve_plate_job_gpus.
#
# CPU-only workflows omit --partition and use Spider's normal/default partition.
BIOMERO_INJECT_GPU_FLAG=true
BIOMERO_GPU_PARTITION=gpu_a100_mig
BIOMERO_GPU_GRES=gpu:a100_3g.20gb:1
# gpu_gres and gpu_gpus are mutually exclusive upstream, and Spider rejects
# --gres and --gpus together, so only BIOMERO_GPU_GRES is set here.

# Per-job env files, because Spider sbatch jobs do not inherit the SSH session
# environment. Upstream writes the file and sources it from generated scripts.
BIOMERO_ENV_FILE_SUBMISSION=true

# Run image pulls/builds as Slurm jobs instead of on the login node, with
# project-local Apptainer temp/cache so Spider's small login /tmp is not used.
BIOMERO_IMAGE_PULL_VIA_SBATCH=true
BIOMERO_PULL_CPUS=8
BIOMERO_PULL_MEM=32G
BIOMERO_APPTAINER_TMPDIR=/project/${SPIDER_PROJECT}/Share/biomero/.apptainer_tmp
BIOMERO_APPTAINER_CACHEDIR=/project/${SPIDER_PROJECT}/Share/biomero/.apptainer_cache

# Spider exposes 7za rather than 7z on some nodes. The upstream default already
# auto-detects both, so this is left unset and documented only so the Spider
# constraint is not forgotten.
# BIOMERO_SLURM_ZIP_CMD=

# OMERO web settings.
OMERO_WEB_ENV=TEST
IMPORT_MOUNT_PATH=/data

# OMERO importer settings.
OMERO_IMPORTER_USER=root
OMERO_IMPORTER_PASSWORD=omero
OMERO_PORT=4064
ADI_RUN_MIGRATIONS=1
OMERO_CONTAINER_USER=1000:1000

# Host path holding every piece of state the stack must not lose. On a Research
# Cloud workspace this is an attached storage volume, mounted at /data/<name>,
# so the data outlives the workspace. Expected layout:
#
#   database/          OMERO Postgres
#   database-biomero/  BIOMERO Postgres
#   omero/             OMERO image repository
#   L-Drive/           user data, mounted as /data in the containers
#   config/            .env, .ssh/, slurm-config.ini -- the secrets
#   backups/           backup_master.sh output
#
# The repo's .env, .ssh and web/slurm-config.ini are symlinks into config/,
# so the volume is the single source of truth for secrets.
OMERO_DATA_PATH=/data/omero-data
