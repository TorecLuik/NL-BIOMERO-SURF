# Template for .env, the single file this deployment reads.
#
#   make init-env           generates every CHANGE ME value below, asking only
#                           for the Spider account, which is the one thing it
#                           cannot know
#   cp .env.example .env    the manual route, if you want to choose them
#
# Nothing reads this file at runtime. It is documentation, so it can never
# shadow a real value or drift into being a second source of truth.
#
# Values fall into three groups, and the difference matters when a storage
# volume is involved:
#
#   [volume]    Baked into the volume's data the first time the stack starts,
#               and read-only afterwards. On an empty volume you choose them;
#               on a volume that already holds data they are already decided
#               and .env must match, or the stack cannot read its own
#               databases. `make check-volume` compares them for you.
#
#   [content]   Stored inside the databases rather than in config. Changeable
#               through the application, so .env must reflect the current
#               value rather than dictate it.
#
#   [free]      Local to this VM. Choose or generate them per deployment.


# -- identity of this deployment ------------------------------------- [free] --

# The mounted storage volume. The portal volume name becomes the directory
# name, and spaces become underscores.
OMERO_DATA_PATH=/data/omero-data

# Your Spider account and project. The SSH key in .ssh/ must be authorised for
# this account -- see `make new-key`.
SPIDER_USER=CHANGE ME
SPIDER_PROJECT=CHANGE ME

# Filename of the private key in .ssh/ used to reach the Slurm cluster. It
# authorises cluster access -- Spider today, and any other host in .ssh/config
# -- so it is deliberately separate from whatever key this VM uses for its git
# remote. Change this only if you keep the key under another name.
SLURM_ACCESS_KEY=slurm_access_key

# Public hostname of this VM, in three places. Set all three with:
#   make set-host HOST=$(hostname -f)
OMERO_CSRF_TRUSTED_ORIGINS=["https://CHANGE-ME.example.org"]
METABASE_SITE_URL=https://CHANGE-ME.example.org/metabase
OBSERVABILITY_ROOT_URL=https://CHANGE-ME.example.org/logs/


# -- database credentials -------------------------------------------- [volume] --

# Postgres seeds these into the cluster on first start and ignores them on
# every start after that, so on an existing volume the value here must match
# what the data already carries. A wrong value is not rejected at startup: the
# containers come up and then fail to authenticate.
POSTGRES_USER=omero
POSTGRES_DB=omero
POSTGRES_PASSWORD=CHANGE ME

BIOMERO_POSTGRES_USER=biomero
BIOMERO_POSTGRES_DB=biomero
BIOMERO_POSTGRES_PASSWORD=CHANGE ME


# -- application accounts -------------------------------------------- [content] --

# The OMERO root account, and the account the importer logs in as. Both live in
# the OMERO database. Changing them here does not change them in an existing
# deployment.
#
# OMERO_IMPORTER_USER ships as root, so OMERO_IMPORTER_PASSWORD is then root's
# password and has to equal OMERO_ROOT_PASSWORD. Two different values there
# leave the importer unable to log in: it retries for five minutes and exits,
# and because nothing restarts it, imports queued from the UI are simply never
# picked up. make init-env keeps them in step. Give the importer its own
# password only if you also give it its own OMERO account.
OMERO_ROOT_PASSWORD=CHANGE ME
OMERO_IMPORTER_USER=root
OMERO_IMPORTER_PASSWORD=CHANGE ME

# Metabase admin, stored in the Metabase application database.
METABASE_USER=CHANGE ME
METABASE_PASSWORD=CHANGE ME

# OMERO.forms master account.
FORMS_MASTER_USER=CHANGE ME
FORMS_MASTER_PASSWORD=CHANGE ME


# -- generated secrets ------------------------------------------------- [free] --

# openssl rand -hex 32
METABASE_SECRET_KEY=CHANGE ME

# Basic auth for /logs, written to /etc/nginx/.htpasswd by `make logs-auth`.
# Without that file nginx answers 401 on /logs while the rest of the site works.
NGINX_LOGS_USER=admin
NGINX_LOGS_PASSWORD=CHANGE ME


# -- component versions ------------------------------------------------------
#
# Pins for the images this stack builds. `make doctor` checks the importer
# submodule against BIOMERO_IMPORTER_VERSION.

NL_BIOMERO_VERSION=1.8.0
BIOMERO_IMPORTER_VERSION=1.4.2
BIOMERO_VERSION=2.8.2
OMERO_ZARR_PIXEL_BUFFER_VERSION=0.6.1
OMERO_FORMS_VERSION=2.3.1
OMERO_BIOMERO_VERSION=1.6.1


# -- Metabase dashboards -----------------------------------------------------
#
# Dashboard ids inside Metabase, surfaced in the OMERO.biomero UI. They come
# from the Metabase application database, so they travel with the volume.

METABASE_IMPORTS_DB_PAGE_DASHBOARD_ID=6
METABASE_WORKFLOWS_DB_PAGE_DASHBOARD_ID=2


# -- optional components -----------------------------------------------------

# BIOMERO.importer frontend. To disable, set IMPORTER_ENABLED=FALSE and
# COMPOSE_PROFILES=adi_disabled.
IMPORTER_ENABLED=TRUE
COMPOSE_PROFILES=IMPORTER_ENABLED

# BIOMERO.analyzer frontend. To disable, set ANALYZER_ENABLED=FALSE.
ANALYZER_ENABLED=TRUE


# -- OMERO runtime -----------------------------------------------------------

OMERO_SCRIPTS_TIMEOUT=604800000
OMERO_SESSIONS_TIMEOUT=604800000
OMERO_WEB_SESSION_EXPIRE_AT_BROWSER_CLOSE=false
OMERO_WEB_SESSION_COOKIE_AGE=604800
OMERO_LOGGING_LEVEL=10
OMERO_WEB_ENV=TEST
OMERO_PORT=4064
OMERO_CONTAINER_USER=1000:1000

# Mount point for user data inside the containers, backed by L-Drive/ on the
# volume.
IMPORT_MOUNT_PATH=/data

# Importer database migrations on startup.
ADI_RUN_MIGRATIONS=1


# -- Slurm and GPU policy ----------------------------------------------------
#
# Keep BIOMERO's Slurm accounting query narrow enough for shared clusters.
BIOMERO_SACCT_START_TIME=today

# inject_gpu_flag makes BIOMERO emit --nv and GPU sbatch resources only for
# workflows whose effective use_gpu is true. Which workflows those are is set
# per workflow with <workflow>_use_gpu in slurm-config.ini, and a request can
# still override it at runtime.
#
# Which GPU a workflow gets is set per workflow in slurm-config.ini, next to
# the reason it needs that one. There is deliberately no global default: the
# right partition differs per workflow -- classic cellpose cannot use a MIG
# slice at all -- so a fallback would only ever be wrong for somebody.
BIOMERO_INJECT_GPU_FLAG=true

# Spider sbatch jobs do not inherit the SSH session environment, so upstream
# writes a per-job env file and sources it from generated scripts.
BIOMERO_ENV_FILE_SUBMISSION=true

# Run image pulls and builds as Slurm jobs instead of on the login node, with
# project-local Apptainer temp/cache so Spider's small login /tmp is not used.
BIOMERO_IMAGE_PULL_VIA_SBATCH=true
BIOMERO_PULL_CPUS=8
BIOMERO_PULL_MEM=32G
BIOMERO_APPTAINER_TMPDIR=/project/${SPIDER_PROJECT}/Share/biomero/.apptainer_tmp
BIOMERO_APPTAINER_CACHEDIR=/project/${SPIDER_PROJECT}/Share/biomero/.apptainer_cache

# Spider exposes 7za rather than 7z on some nodes. The upstream default
# auto-detects both, so this is left unset and noted only so the constraint is
# not forgotten.
# BIOMERO_SLURM_ZIP_CMD=
